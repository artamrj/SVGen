{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://svgen.local/schemas/generation_request.schema.json",
  "title": "SVGen Generation Request",
  "type": "object",
  "required": ["prompt"],
  "additionalProperties": false,
  "properties": {
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "style": {
      "type": "string",
      "enum": ["outline", "filled", "rounded", "duotone", "minimal", "material-like"],
      "default": "outline"
    },
    "size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 512,
      "default": 24
    }
  }
}
